{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/ospd/2026/ogc-process-execution-metadata.schema.json#",
  "title": "OGC API Processes provenance profile example schema",
  "type": "object",
  "required": ["process", "inputs", "outputs", "provenance"],
  "properties": {
    "process": {
      "type": "object",
      "required": ["id", "processType"],
      "properties": {
        "id": { "type": "string" },
        "processType": {
          "type": "string",
          "pattern": "^https://example.org/ospd/2026/process-types/[a-z0-9\\-]+$"
        }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "href"],
        "properties": {
          "id": { "type": "string" },
          "href": { "type": "string" },
          "inputProvenance": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "object" }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "profile": { "type": "string" },
        "bundle": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
